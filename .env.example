# Copy to .env and edit.
# Generate a key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_use_at_least_32_random_characters
ENV=development
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Local development (SQLite, no extra services):
DATABASE_URL=sqlite:///./task_manager.db

# PostgreSQL with docker compose up -d (values from docker-compose.yml):
# DATABASE_URL=postgresql://taskuser:password@localhost:5432/taskdb
